# Matches compose.yaml. Also used by SQLx at compile time and by the tests.
DATABASE_URL=postgres://reoka:reoka@localhost:5435/reoka

BIND_ADDR=127.0.0.1:8080
RUST_LOG=backend_reoka=debug,tower_http=info

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Zalo App secret key, from the app settings on developers.zalo.me
ZALO_APP_SECRET=

# Comma-separated browser origins allowed to call the API. May be empty.
CORS_ALLOWED_ORIGINS=http://localhost:3000
