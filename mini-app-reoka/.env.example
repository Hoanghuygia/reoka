# Zalo Mini App ID and CLI token. ZMP_TOKEN is a secret.
APP_ID=
ZMP_TOKEN=

# Backend base URL, without a trailing slash. Must be HTTPS when the app runs
# inside Zalo on a phone, e.g. a tunnel to localhost:8080.
VITE_API_BASE_URL=http://localhost:8080

# Show raw error codes in deployed test builds. Leave unset for release.
VITE_DEBUG=
